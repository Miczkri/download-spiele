---
import { getSinglePage } from "@/lib/contentParser.astro";
import dateFormat from "@/lib/utils/dateFormat";
import { humanize, plainify, slugify } from "@/lib/utils/textConverter";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { BiCalendarEdit, BiCategoryAlt } from "react-icons/bi";

type Props = {
  posts: CollectionEntry<"posts">[];
  className?: string;
  fluid?: boolean;
};

const authors = await getSinglePage("authors");
const { className, posts, fluid } = Astro.props;
---

<div
  class={`row gy-5 gx-4 ${className} ${posts.length == 1 ? "justify-center" : ""} `}
>
  {
    posts.map((post, i: number) => (
      <div class={i === 0 && fluid != false ? "col-12" : "col-12 sm:col-6"}>
        {post.data.image && (
          <a
            href={`/${post.id}`}
            class="rounded-lg block hover:text-primary overflow-hidden group"
          >
            <Image
              class="w-full rounded-lg"
              src={post.data.image}
              alt={post.data.title}
              width={i === 0 ? 925 : 445}
              height={i === 0 ? 475 : 230}
              fetchpriority="high"
              loading="eager"
              decoding="sync"
              
            />
          </a>
        )}
        <ul class="mt-6 mb-4 flex flex-wrap items-center text-text">
          <li class="mr-5">
            {authors
              .filter((author) =>
                post.data.authors
                  .map((author) => slugify(author))
                  .includes(slugify(author.data.title))
              )
              .map((author) => (
                <a
                  href={`/autor/${slugify(author.data.title)}`}
                  class="flex items-center hover:text-primary font-medium"
                >
                  {author.data.image && (
                    <Image
                      src={author.data.image}
                      alt={author.data.title}
                      height={50}
                      width={50}
                      class="mr-2 h-6 w-6 rounded-full"
                    />
                  )}
                  <span>{author.data.title}</span>
                </a>
              ))}
          </li>
          <li class="mr-5 flex items-center flex-wrap font-medium">
            <BiCalendarEdit className="mr-1 h-5 w-5 text-gray-600" />
            {dateFormat(post.data.date!)}
          </li>
          <li class="mr-5 flex items-center flex-wrap">
            <BiCategoryAlt className="mr-1 h-[18px] w-[18px] text-gray-600" />

            <ul>
              {post.data.categories.map((category, i: number) => (
                <li class="inline-block">
                  <a
                    href={`/kategorien/${slugify(category)}`}
                    class="mr-2 hover:text-primary font-medium"
                  >
                    {humanize(category)}
                    {i !== post.data.categories.length - 1 && ","}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        </ul>
        <h3 class="mb-4">
          <a
            href={`/${post.id}`}
            class="block hover:text-primary transition duration-300"
          >
            {post.data.title}
          </a>
        </h3>
        <p class="text-text line-clamp-2">{plainify(post.body ?? "")}</p>
      </div>
    ))
  }
  <div class="mt-16 pt-8 border-t border-border">
        <h1 class="h5 mb-4">Spiele kostenlos herunterladen</h1>
        <p class="mb-4">
  <div id="seo-content" class="relative max-h-[300px] overflow-hidden transition-all duration-500 ease-in-out">
    <p class="mb-4">
      Hallo, Spieler! Tauche auf download-spiele.com in die Welt deiner Lieblings-PC-Spiele ein!
      Unser modernes Portal ist ein wahres Paradies für Fans digitaler Unterhaltung.
      Hier findet jeder PC-Spieler das Richtige. Bei uns kannst du PC-Spiele kostenlos herunterladen!
    </p>

    <p class="mb-6">
      Auf unserer Website findest du sowohl Kultklassiker als auch Neuerscheinungen.
      Spiele aus deiner Kindheit und die neuesten Hits. Wir hoffen, dass unsere detaillierte Kategorieübersicht
      dir die Navigation und die Suche nach echten Perlen erleichtert. PC-Spiele waren noch nie so einfach und zugänglich!
    </p>

    <h3 class="h5 mt-8 mb-4">Die beliebtesten PC-Spielkategorien</h3>

    <div class="space-y-4 mb-8">
      <div>
        <h3 class="h6 font-bold mb-4">Action-Spiele</h3>
        <p>
          Die größte Gruppe von PC-Spielen, die zugleich ein äußerst vielfältiges Gameplay bietet.
          Hier zählt die Action! Die Spielmechaniken sind dabei vielfältig. Hier finden Sie die größten Spiele,
          die höchsten Budgets und den größten Schwung. Hinzu kommen eine reichhaltige Handlung und ein filmischer Charakter.
          Action-Spiele machen einfach Spaß!
        </p>
      </div>

      <div>
        <h3 class="h6 font-bold mb-1">Strategiespiele</h3>
        <p>
          Bereiten Sie Ihre Taktiken vor, Kommandant. In dieser Unterkategorie übernehmen Sie das Kommando über Ihre Truppen.
          Ob im rundenbasierten Modus, als Echtzeit-Strategiespiel (RTS) oder in einem gemischten Modus. Strategiespiele für den PC bieten etwas wirklich Einzigartiges.
          Sie können darin erobern, kolonisieren, kämpfen, entwickeln, bauen usw. Jede Strategie bietet etwas anderes,
          aber jede ist wirklich fesselnd. Achtung!
        </p>
      </div>

      <div>
        <h3 class="h6 font-bold mb-1">FPS-Spiele</h3>
        <p>
          Virtuelle Shooter. Schlachtfelder, auf denen Sie in die Rolle eines Soldaten schlüpfen. Ganz gleich, ob es sich um Online-
          oder Koop-Shooter handelt. In diesem Genre müssen Sie viel auf verschiedene Gegner schießen. Setzen Sie Ihre Fähigkeiten
          online ein, arbeiten Sie im Team und trainieren Sie, schnell zu reagieren – vielleicht kommen Sie so lebend davon.
        </p>
      </div>

      <div>
        <h3 class="h6 font-bold mb-1">Simulationsspiele</h3>
        <p>
          Simulationen sind ein riesiges Feld! Es handelt sich um Spiele, die Entspannung, Management und Unterhaltung vereinen.
          Heutzutage gibt es eine Vielzahl von Simulatoren, und jeder findet seine Anhänger. Jedes System ist einzigartig.
          Einen Bauernhof, eine Autowerkstatt oder die eigene Sportmannschaft leiten. Hier erscheint mir alles gleichzeitig sehr realistisch und einfach machbar!
        </p>
      </div>

<div>
        <h3 class="h6 font-bold mb-1">RPG-Spiele</h3>
        <p>
          Rollenspiele in ihrer reinsten Form. Erschaffe deinen eigenen Helden, wähle seine Klasse, begib dich auf Abenteuer in Dungeons
          und sammle Erfahrung. Diese Spiele lassen dir alle Möglichkeiten offen. Setze geheimnisvolle Magie und erstklassige Ausrüstung ein.
          Elemente der Charakterentwicklung gibt es in vielen Spielen, aber nur in Rollenspielen erreichen sie ein solches Niveau.
          Jede Welt besticht durch ihre Weite und macht das Unmögliche möglich. Entdeckt die Fantasy-Rollenspiele, in denen ihr gegen furchterregende Monster antritt.
          Probiert die Action-Rollenspiele aus, bei denen die Handlung und ein unterhaltsames Gameplay im Vordergrund stehen. Oder bevorzugen Sie vielleicht etwas Historisches?
          Auch Titel dieses Genres gibt es! Der Spielspaß kennt keine Grenzen: Man schlüpft in die Rolle eines Charakters und stürzt sich in das Abenteuer einer offenen Welt!
          Was könnte schon schiefgehen?
        </p>
      </div>
    </div>
<h3 class="h5 mt-8 mb-4">Die beliebtesten PC-Spiele auf dem Markt</h3>

    <p class="mb-4">
      Das ist ein weites Feld. Welches ist das beliebteste Spiel? Wir werden gar nicht erst versuchen, diese Frage zu beantworten.
      Schließlich hat jeder seine eigenen Vorlieben. Wir stellen euch jedoch einige Titel vor, die sich in unserem Shop am besten verkaufen.
      Wir vertrauen unseren Kunden! Es wäre eine Sünde, „The Witcher“ oder „Diablo“ nicht zu erwähnen, aber diese Spiele erreichen bei uns noch nicht diese Größenordnung.
      Bei uns sind es andere Titel, an die ihr vielleicht gar nicht gedacht hättet, die die Rangliste anführen. Dazu gehören zum Beispiel „Cyberpunk 2077“, <a href="/resident-evil-requiem-kostenlos" class="text-primary underline">„Resident Evil Requiem“</a> oder „Hogwarts Legacy“. Wie immer halten sich <a href="/gta-5-kostenlos" class="text-primary underline">GTA 5</a> und <a href="/red-dead-redemption-2-kostenloser-download" class="text-primary underline">Red Dead Redemption 2</a> an der Spitze – Rockstar enttäuscht einfach nie!
    </p>

    <p class="mb-4">
      In den letzten Jahren erleben Spiele mit sehr hohem Schwierigkeitsgrad eine echte Renaissance.
      An der Spitze stehen natürlich die „Dark Souls“-Reihe und <a href="/elden-ring-nightreign-kostenlos" class="text-primary underline">Elden Ring</a>. Die Bestseller von From Software haben das „Soulslike“-Genre geprägt und verkaufen sich wie warme Semmeln. <a href="/crimson-desert-download-kostenlos" class="text-primary underline">Crimson Desert</a> gehört ebenfalls zu den interessantesten neuen Spielen.
    </p>

    <p class="mb-4">
      Wenn man über den polnischen Markt spricht, kommt man an der <a href="/landwirtschafts-simulator-25-kostenlos" class="text-primary underline">Farming Simulator</a>-Reihe nicht vorbei. Millionen von Spielern weltweit können sich nicht irren. Wenn du lachst, dann weißt du wirklich nicht, worum es geht.
      Lizenzierte Maschinen, dein eigener Bauernhof, dein Charakter, Mikromanagement-Elemente und vieles mehr.
      Dieser Erfolg beruht auf einer Vielzahl von Faktoren. Das überrascht uns überhaupt nicht!
    </p>

    <p class="mb-4">
      Monster zu töten ist immer toll, und dieses Mal kommt man nicht umhin, „Monster Hunter“ zu erwähnen.
      Die Arenen mit gigantischen Bossen sind nur die Spitze des Eisbergs. Wer würde nicht gerne Jäger riesiger Bestien werden? Wer denn?!
    </p>

    <p class="mb-6">
      Auch Sportspiele sind ein Vergnügen für die breite Masse. Wir lassen <a href="/ea-sports-fc-26-kostenlos" class="text-primary underline">EA Sports FC</a> einmal beiseite und konzentrieren uns dieses Mal auf Basketball. NBA 2K ist eine phänomenale Serie, voller Wettkämpfe,
      Fortschritte und Spezialmissionen. Jeder erzielte Punkt ist eine Freude, und die Grafik ist atemberaubend.
      Ein Paradies für Basketballfans – wir empfehlen es wärmstens!
    </p>

    <h3 class="h5 mt-8 mb-4">Viel Spaß</h3>

    <p class="mb-4">
      Wir haben noch nicht einmal 1 % aller Titel erwähnt, die wir anbieten. Es ist nur logisch, dass die meisten davon ein Geheimnis bleiben.
      Sie sind in den Geheimnissen unserer Website verborgen. Wir laden euch ein, sie zu entdecken! Wir haben Spiele für jeden Anlass,
      für Spieler jeden Alters. Die Welten von Star Wars oder Der Herr der Ringe sind uns nicht fremd.
      Wir unterstützen alle digitalen Vertriebsplattformen. Wir arbeiten mit großen Unternehmen und unabhängigen Entwicklern zusammen.
      Wir lieben Spiele!
    </p>

    <p class="mb-4">
      PC-Spiele sind unsere Leidenschaft: Vertrauen Sie uns und begeben Sie sich auf eine Reise voller digitaler Unterhaltung.
      Folgen Sie uns in den sozialen Netzwerken und laden Sie Spiele kostenlos aus einer vertrauenswürdigen Quelle herunter. Herzlich willkommen!
    </p>

<div id="seo-overlay" class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-body to-transparent pointer-events-none"></div>
  </div>

  <div class="text-center mt-4">
    <button id="seo-toggle-btn" class="btn btn-outline-primary text-sm px-6 py-2">
      Lire la suite
    </button>
  </div>

<script>
  const content = document.getElementById('seo-content');
  const overlay = document.getElementById('seo-overlay');
  const btn = document.getElementById('seo-toggle-btn');

  if (content && overlay && btn) {
    btn.addEventListener('click', () => {
      const isExpanded = content.classList.contains('max-h-full');

      if (isExpanded) {
        // Zwijanie
        content.classList.remove('max-h-full');
        content.classList.add('max-h-[300px]');
        overlay.classList.remove('hidden');
        btn.textContent = 'Lire la suite';
      } else {
        // Rozwijanie
        content.classList.remove('max-h-[300px]');
        content.classList.add('max-h-full');
        overlay.classList.add('hidden');
        btn.textContent = 'Réduire';
      }
    });
  }
</script>
        </p>
      </div>
</div>
